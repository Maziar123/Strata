 from __future__ import annotations
 
+import os
 import re
 from pathlib import Path
 from typing import Iterable, Iterator, TYPE_CHECKING
@@ -59,6 +60,48 @@ class KimiK3Model(TextModel):
     def __init__(self, *args, **kwargs):
         super().__init__(*args, **kwargs)
         self._res_parts = {}
+        self._init_dsa()
+
+    #
+    # Kimi-K3.1 DSA indexer
+    #
+    # K3.1 is K3 with a lightning indexer on every full-attention (MLA) layer; every
+    # other tensor has the same name, dtype and shape. It is the DeepSeek-V3.2 indexer
+    # without RoPE:
+    #     q_idx = wq_b(q_a_norm(q_a(x)))    k_idx = LayerNorm(wk(x))    w = weights_proj(x)
+    #     score = sum_h relu(q_idx_h . k_idx) * w_h  ->  each query attends to its top-k keys
+    # so it is written as kimi-k3 plus the indexer keys and tensors. Keyed on dsa_config,
+    # not on the architecture name: re-uploads label K3.1 as KimiK3ForConditionalGeneration.
+    #
+    # KIMI_K31_DENSE=1 drops the indexer: the file is then a plain kimi-k3 GGUF that loads
+    # in llama.cpp builds without indexer support, with dense attention, which is exact
+    # while the context holds at most index_topk tokens.
+    #
+
+    def _init_dsa(self) -> None:
+        self._dsa = self.hparams.get("dsa_config")
+        self._dsa_dense = os.environ.get("KIMI_K31_DENSE", "0") not in ("", "0")
+        if self._dsa is None:
+            return
+
+        dsa = self._dsa
+        # what llama.cpp implements; fail loudly on a checkpoint that wants more
+        if dsa.get("index_rope_dim", 0) != 0:
+            raise NotImplementedError(f"indexer RoPE (index_rope_dim={dsa['index_rope_dim']})")
+        if dsa.get("index_topk_freq", 1) != 1:
+            raise NotImplementedError(f"indexer sharing across layers (index_topk_freq={dsa['index_topk_freq']})")
+        if dsa.get("index_k_norm_type", "rmsnorm") != "layernorm":
+            raise NotImplementedError(f"indexer k_norm type {dsa.get('index_k_norm_type')!r}")
+        if sorted(dsa["dsa_layers"]) != sorted(self.hparams["linear_attn_config"]["full_attn_layers"]):
+            raise NotImplementedError("DSA layers differ from the full-attention layers")
+        if self.hparams.get("q_lora_rank") is None:
+            raise NotImplementedError("the indexer query needs q_lora_rank")
+
+        if self._dsa_dense:
+            logger.warning("KIMI_K31_DENSE=1: dropping the DSA indexer, attention will be dense")
+        else:
+            logger.info(f"Kimi-K3.1 DSA indexer: {dsa['index_num_heads']} heads x {dsa['index_head_dim']}, "
+                        f"top-{dsa['index_topk']}, on {len(dsa['dsa_layers'])} layers")
 
     def set_vocab(self):
         # K3 has the same TikToken vocab as K2, so kimi-linear's vocab handling works.
@@ -226,6 +269,12 @@ class KimiK3Model(TextModel):
         # --- cross-layer attention residuals ---
         self.gguf_writer.add_attn_res_block_size(self.hparams["attn_res_block_size"])
 
+        # --- K3.1 DSA indexer ---
+        if self._dsa is not None and not self._dsa_dense:
+            self.gguf_writer.add_indexer_head_count(self._dsa["index_num_heads"])
+            self.gguf_writer.add_indexer_key_length(self._dsa["index_head_dim"])
+            self.gguf_writer.add_indexer_top_k(self._dsa["index_topk"])
+
     def prepare_tensors(self):
         super().prepare_tensors()
         if self._experts is not None:
@@ -267,6 +316,16 @@ class KimiK3Model(TextModel):
         return None
 
     def modify_tensors(self, data_torch: Tensor, name: str, bid: int | None) -> Iterable[tuple[str, Tensor]]:
+        # --- K3.1 DSA indexer: names map as for DeepSeek-V3.2 ---
+        if ".self_attn.indexer." in name:
+            if self._dsa is None:
+                raise ValueError(f"indexer tensor {name!r} in a checkpoint without dsa_config")
+            if self._dsa_dense:
+                return
+            assert bid is not None and (bid + 1) in self._dsa["dsa_layers"], name
+            yield from super().modify_tensors(data_torch, name, bid)
+            return
+
         # --- cross-layer attention residuals: fuse norm * proj ---
         fused = self._try_fuse_res(data_torch, name, bid)
         if fused is not None:
@@ -343,3 +402,11 @@ class KimiK3Model(TextModel):
             return
 
         yield from super().modify_tensors(data_torch, name, bid)
+

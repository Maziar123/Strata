+//
+// Kimi-K3.1 DSA lightning indexer (DeepSeek-V3.2's, nope-only):
+//   q = wq_b_idx(qr)   k = LayerNorm(wk_idx(x))   w = weights_proj(x) / sqrt(head_dim * n_head)
+//   score[kv, t] = sum_h relu(q[h, t] . k[kv]) * w[h, t]   (+ the attention mask)
+// returns the indices of the top-k cells, [n_top, n_tokens]
+//
+
+ggml_tensor * llama_model_kimi_k3::graph::build_dsa_top_k(
+        ggml_tensor * cur, ggml_tensor * qr, const llama_layer & layer,
+        llm_graph_input_attn_k * inp_attn_k, const llama_kv_cache_context * mctx_idx, int il) {
+    GGML_ASSERT(qr != nullptr);
+
+    const int64_t n_idx_head = hparams.indexer_n_head;
+    const int64_t n_embd_idx = hparams.indexer_head_size;
+
+    // {n_embd_idx, n_idx_head, n_tokens}
+    ggml_tensor * idx_q = ggml_mul_mat(ctx0, layer.indexer_attn_q_b, qr);
+    idx_q = ggml_reshape_3d(ctx0, idx_q, n_embd_idx, n_idx_head, n_tokens);
+    cb(idx_q, "indexer_q", il);
+
+    // {n_embd_idx, 1, n_tokens}
+    ggml_tensor * idx_k = ggml_mul_mat(ctx0, layer.indexer_attn_k, cur);
+    idx_k = build_norm(idx_k, layer.indexer_k_norm, layer.indexer_k_norm_b, LLM_NORM, il);
+    idx_k = ggml_reshape_3d(ctx0, idx_k, n_embd_idx, 1, n_tokens);
+    cb(idx_k, "indexer_k", il);
+
+    // the indexer cache shares the MLA cache's cells, so its slots are the same k_idxs
+    ggml_build_forward_expand(gf, mctx_idx->cpy_k(ctx0, idx_k, inp_attn_k->get_k_idxs(), il));
+
+    // {n_idx_head, n_tokens}, prescaled so the big score tensor needs no extra scale
+    ggml_tensor * idx_w = ggml_mul_mat(ctx0, layer.indexer_proj, cur);
+    idx_w = ggml_scale(ctx0, idx_w, 1.0f / sqrtf(float(n_embd_idx * n_idx_head)));
+    cb(idx_w, "indexer_weights", il);
+
+    // cached keys {n_embd_idx, 1, n_kv, n_stream}
+    ggml_tensor * k_all = mctx_idx->get_k(ctx0, il);
+
+    const int64_t n_stream = k_all->ne[3];
+    idx_q = ggml_view_4d(ctx0, idx_q, idx_q->ne[0], idx_q->ne[1], idx_q->ne[2]/n_stream, n_stream,
+                         idx_q->nb[1], idx_q->nb[2], idx_q->nb[2]*(idx_q->ne[2]/n_stream), 0);
+    idx_w = ggml_view_4d(ctx0, idx_w, idx_w->ne[0], idx_w->ne[1]/n_stream, 1, n_stream,
+                         idx_w->nb[1], idx_w->nb[1]*(idx_w->ne[1]/n_stream), idx_w->nb[1]*(idx_w->ne[1]/n_stream), 0);
+
+    ggml_tensor * kq_mask = inp_attn_k->self_attn_mask.raw; // [n_kv, n_tokens/n_stream, 1, n_stream]
+
+    ggml_tensor * score = nullptr;
+    if (cparams.fused_lid) {
+        // the fused indexer takes an f16 mask; the attention mask is f32 without flash attention.
+        // casting it is cheap next to the [n_idx_head, n_tokens, n_kv] scores the plain ops build
+        ggml_tensor * mask_f16 = kq_mask->type == GGML_TYPE_F16 ? kq_mask : ggml_cast(ctx0, kq_mask, GGML_TYPE_F16);
+        score = ggml_lightning_indexer(ctx0, idx_q, k_all, idx_w, mask_f16);
+        res->add_fused_node({LLM_FUSED_OP_LIGHTNING_INDEXER, score, il});
+    } else {
+        // {n_embd_idx, n_tokens, n_idx_head, n_stream} x {n_embd_idx, n_kv, 1, n_stream}
+        ggml_tensor * q_p = ggml_permute(ctx0, idx_q, 0, 2, 1, 3);
+        ggml_tensor * k_p = ggml_permute(ctx0, k_all, 0, 2, 1, 3);
+
+        // {n_kv, n_tokens, n_idx_head, n_stream}
+        ggml_tensor * kq = ggml_mul_mat(ctx0, k_p, q_p);
+        // -> {n_idx_head, n_tokens, n_kv, n_stream}, contiguous for relu
+        kq = ggml_cont(ctx0, ggml_permute(ctx0, kq, 2, 1, 0, 3));
+        kq = ggml_relu(ctx0, kq);
+        kq = ggml_mul(ctx0, kq, idx_w);
+        // {1, n_tokens, n_kv, n_stream} -> {n_kv, n_tokens, 1, n_stream}
+        kq = ggml_sum_rows(ctx0, kq);
+        score = ggml_cont(ctx0, ggml_permute(ctx0, kq, 2, 1, 0, 3));
+        // the mask is f16 under flash attention
+        score = ggml_add(ctx0, score, kq_mask->type == GGML_TYPE_F32 ? kq_mask : ggml_cast(ctx0, kq_mask, GGML_TYPE_F32));
+    }
+    cb(score, "indexer_score", il);
+
+    const uint32_t n_top = std::min<uint32_t>((uint32_t) score->ne[0], hparams.indexer_top_k);
+    ggml_tensor * top_k = ggml_cont(ctx0, ggml_top_k(ctx0, score, n_top));
+    cb(top_k, "top_k", il);
+
+    return top_k;
+}

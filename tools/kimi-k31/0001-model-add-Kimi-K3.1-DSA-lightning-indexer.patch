diff --git a/src/llama-quant.cpp b/src/llama-quant.cpp
index d62f7d5..711432c 100644
--- a/src/llama-quant.cpp
+++ b/src/llama-quant.cpp
@@ -371,6 +371,17 @@ static bool tensor_allows_quantization(const llama_model_quantize_params * param
         quantize &= name.find("hc_")            == std::string::npos;
     }
 
+    // kimi-k3.1: the DSA indexer picks the keys every MLA layer attends to and is tiny
+    // (~180M params in all), keep it out of low-bit quantization
+    if (arch == LLM_ARCH_KIMI_K3) {
+        quantize &= name.find("indexer.") == std::string::npos;
+        // the absorbed MLA k_b/v_b (~300M params in all) have 128-wide rows, so K-quants fall back
+        // to q4_0, and the CPU repack buffer cannot run a 3D q4_0 k_b against the permuted query
+        // (GGML_ASSERT in ggml_backend_sched_split_graph); keep them as glm5-next does
+        quantize &= name.find("attn_k_b.weight") == std::string::npos;
+        quantize &= name.find("attn_v_b.weight") == std::string::npos;
+    }
+
